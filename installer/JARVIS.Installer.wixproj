<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <JarvisExePath>$(MSBuildProjectDirectory)\..\dist\JARVIS.exe</JarvisExePath>
    <DefineConstants>JarvisExePath=$(JarvisExePath)</DefineConstants>
  </PropertyGroup>
</Project>
